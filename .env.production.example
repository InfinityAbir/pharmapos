# =============================================================================
# PharmaPOS PRODUCTION environment
# Copy to `.env.production` and fill in EVERY value. NEVER commit the filled
# file. Generate secrets with:  openssl rand -base64 32
#
# Deploy with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# =============================================================================

# ---- Public surface ----
# Browser-reachable hostname (no scheme, no trailing slash).
PUBLIC_HOST=pos.example.com
# Public Keycloak host. Defaults to PUBLIC_HOST (Keycloak served through the
# reverse proxy). Use a dedicated host (e.g. auth.example.com) with its own
# certificate if Keycloak gets heavy direct traffic.
KEYCLOAK_PUBLIC_HOST=pos.example.com

# ---- Application database (PostgreSQL) ----
POSTGRES_DB=pharmapos
POSTGRES_USER=pharmapos
# REQUIRED, strong, unique to this environment.
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-32
POSTGRES_PORT=5432

# ---- Keycloak database (separate Postgres, separate credentials) ----
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
# REQUIRED, strong, different from POSTGRES_PASSWORD.
KC_DB_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# ---- Keycloak realm ----
KEYCLOAK_ADMIN=admin
# REQUIRED. Bootstrap admin; rotate after first login.
KEYCLOAK_ADMIN_PASSWORD=change-me-min-16-chars-upper-lower-digit
KEYCLOAK_PORT=8090
KEYCLOAK_REALM=pharmapos
KEYCLOAK_AUDIENCE=pharmapos-api
# Confidential client secret for the API's server-side Keycloak calls.
# Must match the pharmapos-api client secret in YOUR production realm (never the dev export).
KEYCLOAK_CLIENT_SECRET=change-me-generate-with-openssl-rand-base64-32
# Hostname Keycloak advertises (must match the public URL the proxy serves).
KEYCLOAK_HOSTNAME=https://pos.example.com
# Issuer the API accepts. MUST be the browser-reachable public issuer:
# the API fetches metadata internally, but tokens carry this issuer.
KEYCLOAK_PUBLIC_ISSUER=https://pos.example.com/realms/pharmapos

# ---- Images (CI-built, pinned by digest or immutable tag per release) ----
API_IMAGE=pharmapos-api:latest
WEB_IMAGE=pharmapos-web:latest
