# Normalize line endings across platforms.
* text=auto eol=lf

# Windows-only scripts keep CRLF so they run without conversion surprises.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets are never line-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
