# =============================================================================
# PharmaPOS local environment configuration
# Copy to `.env` and adjust. NEVER commit `.env`.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=pharmapos
POSTGRES_USER=pharmapos
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
# Inside docker-compose the API reaches Postgres/Keycloak by service name.
ConnectionStrings__Database=Host=postgres;Port=5432;Database=pharmapos;Username=pharmapos;Password=change-me-in-production

# ---- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8090
KEYCLOAK_REALM=pharmapos
KEYCLOAK_AUTHORITY=http://localhost:8090/realms/pharmapos
KEYCLOAK_AUDIENCE=pharmapos-api
KEYCLOAK_REQUIRE_HTTPS=false
# Split-horizon: the API fetches OIDC metadata over the internal authority above, but the tokens
# browsers receive carry this public issuer, so the API must accept it explicitly.
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8090/realms/pharmapos

# ---- Frontend ----
FRONTEND_PORT=4200
WEB_API_BASE_URL=http://localhost:8080/api/v1
WEB_OIDC_AUTHORITY=http://localhost:8090/realms/pharmapos
WEB_OIDC_CLIENT_ID=pharmapos-web
WEB_OIDC_REDIRECT_URI=http://localhost:4200/callback

# ---- Migrations & seed data ----
# When true the API applies EF Core migrations on startup (Development only).
Database__ApplyMigrationsOnStartup=true
# When true the API seeds the demo tenant used for local development (never in production).
Database__SeedDemoData=true

# ---- Demo identities (imported by Keycloak from deploy/keycloak/realm-export.json) ----
# Platform admin  : admin@pharmapos.local    / Platform#2026!  (tenant_id=demo-pharmacy)
# Pharmacy owner  : owner@demo-pharmacy.local / Pharmacy#2026!  (tenant_id=demo-pharmacy)

